/ { soc {
spmi_bus: spmi@c440000 {
   compatible = "qcom,spmi-pmic-arb";
   reg = <0x0 0x0c440000 0x0 0x1100>,
         <0x0 0x0c600000 0x0 0x2000000>,
         <0x0 0x0e600000 0x0 0x100000>,
         <0x0 0x0e700000 0x0 0xa0000>,
         <0x0 0x0c40a000 0x0 0x26000>;
   reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
   interrupt-names = "periph_irq";
   interrupts-extended = <&pdc 1 4>;
   qcom,ee = <0>;
   qcom,channel = <0>;
   #address-cells = <2>;
   #size-cells = <0>;
   interrupt-controller;
   #interrupt-cells = <4>;
  };
}; };
&spmi_bus {
    pmic@0 {
        compatible = "qcom,pmk8350", "qcom,spmi-pmic";
        reg = <0 0>;
        #address-cells = <1>;
        #size-cells = <0>;
        pon@1300 {
            compatible = "qcom,pmk8350-pon";
            reg = <0x1300>, <0x800>;
            reg-names = "hlos", "pbs";
            pwrkey {
                compatible = "qcom,pmk8350-pwrkey";
                interrupts = <0 0x13 7 (2 | 1)>;
                interrupt-parent = <&spmi_bus>;
                linux,code = <116>;
                wakeup-source;
            };
        };
    };
};
/ {
    /delete-node/ pmic-glink;
    /delete-node/ smp2p-adsp;
};
&{/soc} { /delete-node/ remoteproc@17300000; };
&{/chosen} { /delete-property/ mars,fixed-host-test; };
&{/soc/usb@a6f8800/usb@a600000} {
    dr_mode = "peripheral";
    /delete-property/ usb-role-switch;
    /delete-property/ role-switch-default-mode;
};
/ { soc {
    mars_dsi_refgen: regulator@88e7000 {
        compatible = "qcom,sm8250-refgen-regulator";
        reg = <0 0x088e7000 0 0x84>;
        regulator-name = "mars-dsi-refgen";
        regulator-boot-on;
        regulator-always-on;
        regulator-enable-ramp-delay = <5>;
    };
mc_virt: interconnect@1580000 {
   compatible = "qcom,sm8350-mc-virt";
   reg = <0 0x01580000 0 0x1000>;
   #interconnect-cells = <2>;
   qcom,bcm-voters = <&apps_bcm_voter>;
  };
mmss_noc: interconnect@1740000 {
   compatible = "qcom,sm8350-mmss-noc";
   reg = <0 0x01740000 0 0x1f080>;
   #interconnect-cells = <2>;
   qcom,bcm-voters = <&apps_bcm_voter>;
  };
gem_noc: interconnect@9100000 {
   compatible = "qcom,sm8350-gem-noc";
   reg = <0 0x09100000 0 0xb4000>;
   #interconnect-cells = <2>;
   qcom,bcm-voters = <&apps_bcm_voter>;
  };
mdss: display-subsystem@ae00000 {
   compatible = "qcom,sm8350-mdss";
   reg = <0 0x0ae00000 0 0x1000>;
   reg-names = "mdss";
   interconnects = <&mmss_noc 7 0 &mc_virt 1 0>,
     <&mmss_noc 8 0 &mc_virt 1 0>;
   interconnect-names = "mdp0-mem", "mdp1-mem";
   power-domains = <&dispcc 0>;
   resets = <&dispcc 0>;
   clocks = <&dispcc 0>,
     <&gcc 27>,
     <&gcc 28>,
     <&dispcc 32>;
   clock-names = "iface", "bus", "nrt_bus", "core";
   interrupts = <0 83 4>;
   interrupt-controller;
   #interrupt-cells = <1>;
   iommus = <&apps_smmu 0x820 0x402>;
   status = "disabled";
   #address-cells = <2>;
   #size-cells = <2>;
   ranges;
   dpu_opp_table: opp-table {
    compatible = "operating-points-v2";
    opp-200000000 {
     opp-hz = /bits/ 64 <200000000>;
     required-opps = <&rpmhpd_opp_svs>;
    };
    opp-300000000 {
     opp-hz = /bits/ 64 <300000000>;
     required-opps = <&rpmhpd_opp_svs>;
    };
    opp-345000000 {
     opp-hz = /bits/ 64 <345000000>;
     required-opps = <&rpmhpd_opp_svs_l1>;
    };
    opp-460000000 {
     opp-hz = /bits/ 64 <460000000>;
     required-opps = <&rpmhpd_opp_nom>;
    };
   };
   mdss_mdp: display-controller@ae01000 {
    compatible = "qcom,sm8350-dpu";
    reg = <0 0x0ae01000 0 0x8f000>,
          <0 0x0aeb0000 0 0x2008>;
    reg-names = "mdp", "vbif";
    clocks = <&gcc 27>,
     <&gcc 28>,
     <&dispcc 0>,
     <&dispcc 34>,
     <&dispcc 32>,
     <&dispcc 44>;
    clock-names = "bus",
           "nrt_bus",
           "iface",
           "lut",
           "core",
           "vsync";
    assigned-clocks = <&dispcc 44>;
    assigned-clock-rates = <19200000>;
    operating-points-v2 = <&dpu_opp_table>;
    power-domains = <&rpmhpd 6>;
    interrupt-parent = <&mdss>;
    interrupts = <0>;
    ports {
     #address-cells = <1>;
     #size-cells = <0>;
     port@0 {
      reg = <0>;
      dpu_intf1_out: endpoint {
       remote-endpoint = <&mdss_dsi0_in>;
      };
     };
     port@1 {
      reg = <1>;
      dpu_intf2_out: endpoint {
       remote-endpoint = <&mdss_dsi1_in>;
      };
     };
     port@2 {
      reg = <2>;
      dpu_intf0_out: endpoint {
       remote-endpoint = <&mdss_dp_in>;
      };
     };
    };
   };
   mdss_dp: displayport-controller@ae90000 {
    compatible = "qcom,sm8350-dp";
    reg = <0 0xae90000 0 0x200>,
          <0 0xae90200 0 0x200>,
          <0 0xae90400 0 0x600>,
          <0 0xae91000 0 0x400>,
          <0 0xae91400 0 0x400>;
    interrupt-parent = <&mdss>;
    interrupts = <12>;
    clocks = <&dispcc 0>,
      <&dispcc 12>,
      <&dispcc 18>,
      <&dispcc 21>,
      <&dispcc 26>;
    clock-names = "core_iface",
           "core_aux",
           "ctrl_link",
           "ctrl_link_iface",
           "stream_pixel";
    assigned-clocks = <&dispcc 19>,
        <&dispcc 27>;
    assigned-clock-parents = <&usb_1_qmpphy 1>,
        <&usb_1_qmpphy 2>;
    phys = <&usb_1_qmpphy 1>;
    phy-names = "dp";
    #sound-dai-cells = <0>;
    operating-points-v2 = <&dp_opp_table>;
    power-domains = <&rpmhpd 6>;
    status = "disabled";
    ports {
     #address-cells = <1>;
     #size-cells = <0>;
     port@0 {
      reg = <0>;
      mdss_dp_in: endpoint {
       remote-endpoint = <&dpu_intf0_out>;
      };
     };
    };
    dp_opp_table: opp-table {
     compatible = "operating-points-v2";
     opp-160000000 {
      opp-hz = /bits/ 64 <160000000>;
      required-opps = <&rpmhpd_opp_low_svs>;
     };
     opp-270000000 {
      opp-hz = /bits/ 64 <270000000>;
      required-opps = <&rpmhpd_opp_svs>;
     };
     opp-540000000 {
      opp-hz = /bits/ 64 <540000000>;
      required-opps = <&rpmhpd_opp_svs_l1>;
     };
     opp-810000000 {
      opp-hz = /bits/ 64 <810000000>;
      required-opps = <&rpmhpd_opp_nom>;
     };
    };
   };
   mdss_dsi0: dsi@ae94000 {
    compatible = "qcom,sm8350-dsi-ctrl", "qcom,mdss-dsi-ctrl";
    reg = <0 0x0ae94000 0 0x400>;
    reg-names = "dsi_ctrl";
    interrupt-parent = <&mdss>;
    interrupts = <4>;
    clocks = <&dispcc 2>,
      <&dispcc 5>,
      <&dispcc 36>,
      <&dispcc 28>,
      <&dispcc 0>,
      <&gcc 27>;
    clock-names = "byte",
           "byte_intf",
           "pixel",
           "core",
           "iface",
           "bus";
    assigned-clocks = <&dispcc 3>,
        <&dispcc 37>;
    assigned-clock-parents = <&mdss_dsi0_phy 0>,
        <&mdss_dsi0_phy 1>;
    operating-points-v2 = <&dsi0_opp_table>;
    power-domains = <&rpmhpd 6>;
    phys = <&mdss_dsi0_phy>;
    #address-cells = <1>;
    #size-cells = <0>;
    status = "disabled";
    dsi0_opp_table: opp-table {
     compatible = "operating-points-v2";
     opp-187500000 {
      opp-hz = /bits/ 64 <187500000>;
      required-opps = <&rpmhpd_opp_svs>;
     };
     opp-300000000 {
      opp-hz = /bits/ 64 <300000000>;
      required-opps = <&rpmhpd_opp_svs>;
     };
     opp-358000000 {
      opp-hz = /bits/ 64 <358000000>;
      required-opps = <&rpmhpd_opp_svs_l1>;
     };
    };
    ports {
     #address-cells = <1>;
     #size-cells = <0>;
     port@0 {
      reg = <0>;
      mdss_dsi0_in: endpoint {
       remote-endpoint = <&dpu_intf1_out>;
      };
     };
     port@1 {
      reg = <1>;
      mdss_dsi0_out: endpoint {
      };
     };
    };
   };
   mdss_dsi0_phy: phy@ae94400 {
    compatible = "qcom,sm8350-dsi-phy-5nm";
    reg = <0 0x0ae94400 0 0x200>,
          <0 0x0ae94600 0 0x280>,
          <0 0x0ae94900 0 0x27c>;
    reg-names = "dsi_phy",
         "dsi_phy_lane",
         "dsi_pll";
    #clock-cells = <1>;
    #phy-cells = <0>;
    clocks = <&dispcc 0>,
      <&rpmhcc 0>;
    clock-names = "iface", "ref";
    status = "disabled";
   };
   mdss_dsi1: dsi@ae96000 {
    compatible = "qcom,sm8350-dsi-ctrl", "qcom,mdss-dsi-ctrl";
    reg = <0 0x0ae96000 0 0x400>;
    reg-names = "dsi_ctrl";
    interrupt-parent = <&mdss>;
    interrupts = <5>;
    clocks = <&dispcc 6>,
      <&dispcc 9>,
      <&dispcc 38>,
      <&dispcc 30>,
      <&dispcc 0>,
      <&gcc 27>;
    clock-names = "byte",
           "byte_intf",
           "pixel",
           "core",
           "iface",
           "bus";
    assigned-clocks = <&dispcc 7>,
        <&dispcc 39>;
    assigned-clock-parents = <&mdss_dsi1_phy 0>,
        <&mdss_dsi1_phy 1>;
    operating-points-v2 = <&dsi1_opp_table>;
    power-domains = <&rpmhpd 6>;
    phys = <&mdss_dsi1_phy>;
    #address-cells = <1>;
    #size-cells = <0>;
    status = "disabled";
    dsi1_opp_table: opp-table {
     compatible = "operating-points-v2";
     opp-187500000 {
      opp-hz = /bits/ 64 <187500000>;
      required-opps = <&rpmhpd_opp_svs>;
     };
     opp-300000000 {
      opp-hz = /bits/ 64 <300000000>;
      required-opps = <&rpmhpd_opp_svs>;
     };
     opp-358000000 {
      opp-hz = /bits/ 64 <358000000>;
      required-opps = <&rpmhpd_opp_svs_l1>;
     };
    };
    ports {
     #address-cells = <1>;
     #size-cells = <0>;
     port@0 {
      reg = <0>;
      mdss_dsi1_in: endpoint {
       remote-endpoint = <&dpu_intf2_out>;
      };
     };
     port@1 {
      reg = <1>;
      mdss_dsi1_out: endpoint {
      };
     };
    };
   };
   mdss_dsi1_phy: phy@ae96400 {
    compatible = "qcom,sm8350-dsi-phy-5nm";
    reg = <0 0x0ae96400 0 0x200>,
          <0 0x0ae96600 0 0x280>,
          <0 0x0ae96900 0 0x27c>;
    reg-names = "dsi_phy",
         "dsi_phy_lane",
         "dsi_pll";
    #clock-cells = <1>;
    #phy-cells = <0>;
    clocks = <&dispcc 0>,
      <&rpmhcc 0>;
    clock-names = "iface", "ref";
    status = "disabled";
   };
  };
dispcc: clock-controller@af00000 {
   compatible = "qcom,sm8350-dispcc";
   reg = <0 0x0af00000 0 0x10000>;
   clocks = <&rpmhcc 0>,
     <&mdss_dsi0_phy 0>, <&mdss_dsi0_phy 1>,
     <&mdss_dsi1_phy 0>, <&mdss_dsi1_phy 1>,
     <&usb_1_qmpphy 1>,
     <&usb_1_qmpphy 2>;
   clock-names = "bi_tcxo",
          "dsi0_phy_pll_out_byteclk",
          "dsi0_phy_pll_out_dsiclk",
          "dsi1_phy_pll_out_byteclk",
          "dsi1_phy_pll_out_dsiclk",
          "dp_phy_pll_link_clk",
          "dp_phy_pll_vco_div_clk";
   #clock-cells = <1>;
   #reset-cells = <1>;
   #power-domain-cells = <1>;
   power-domains = <&rpmhpd 6>;
  };
};
    mars_panel_io: regulator-panel-io {
        compatible = "regulator-fixed";
        regulator-name = "display_prim_vddi";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        gpio = <&tlmm 13 0>;
        enable-active-high;
        regulator-boot-on;
        regulator-always-on;
    };
    mars_panel_core: regulator-panel-core {
        compatible = "regulator-fixed";
        regulator-name = "display_prim_vddd";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        gpio = <&tlmm 74 0>;
        enable-active-high;
        regulator-boot-on;
        regulator-always-on;
    };
};
&apps_rsc {
apps_bcm_voter: bcm-voter {
    compatible = "qcom,bcm-voter";
   };
    mars_display_regulators_b {
        compatible = "qcom,pm8350-rpmh-regulators";
        qcom,pmic-id = "b";
        mars_dsi_phy_supply: ldo5 {
            regulator-name = "mars_pm8350_l5";
            regulator-min-microvolt = <880000>;
            regulator-max-microvolt = <888000>;
            regulator-allow-set-load;
        };
        mars_dsi_supply: ldo6 {
            regulator-name = "mars_pm8350_l6";
            regulator-min-microvolt = <1200000>;
            regulator-max-microvolt = <1208000>;
            regulator-allow-set-load;
        };
    };
    mars_display_regulators_c {
        compatible = "qcom,pm8350c-rpmh-regulators";
        qcom,pmic-id = "c";
        mars_panel_avdd: ldo12 {
            regulator-name = "mars_pm8350c_l12";
            regulator-min-microvolt = <1800000>;
            regulator-max-microvolt = <2000000>;
            regulator-allow-set-load;
        };
        mars_panel_vdd: ldo13 {
            regulator-name = "mars_pm8350c_l13";
            regulator-min-microvolt = <3000000>;
            regulator-max-microvolt = <3000000>;
            regulator-allow-set-load;
        };
    };
};
&mdss {
    status = "okay";
    /delete-node/ displayport-controller@ae90000;
};
&mdss_mdp { ports { /delete-node/ port@2; }; };
&dispcc {
    clocks = <&rpmhcc 0>, <&mdss_dsi0_phy 0>, <&mdss_dsi0_phy 1>,
             <&mdss_dsi1_phy 0>, <&mdss_dsi1_phy 1>;
    clock-names = "bi_tcxo", "dsi0_phy_pll_out_byteclk", "dsi0_phy_pll_out_dsiclk",
                  "dsi1_phy_pll_out_byteclk", "dsi1_phy_pll_out_dsiclk";
};
&mdss_dsi0 {
    status = "okay";
    vdda-supply = <&mars_dsi_supply>;
    refgen-supply = <&mars_dsi_refgen>;
    qcom,preserve-mars-factory-dsc-pps;
    pinctrl-names = "default";
    pinctrl-0 = <&mars_panel_te>;
    panel@0 {
        compatible = "xiaomi,mars-k2-38-08-0a";
        reg = <0>;
        reset-gpios = <&tlmm 24 1>;
        vddio-supply = <&mars_panel_io>;
        vdd-supply = <&mars_panel_vdd>;
        avdd-supply = <&mars_panel_avdd>;
        vddd-supply = <&mars_panel_core>;
        port { mars_panel_in: endpoint {
            remote-endpoint = <&mdss_dsi0_out>;
        }; };
    };
};
&mdss_dsi0_out {
    remote-endpoint = <&mars_panel_in>;
    data-lanes = <0 1 2 3>;
};
&mdss_dsi0_phy {
    status = "okay";
    vdds-supply = <&mars_dsi_phy_supply>;
};
&tlmm {
    gpio-reserved-ranges = <0 13>, <14 10>, <25 49>, <75 7>, <83 120>;
    mars_panel_te: panel-te-state {
        pins = "gpio82";
        function = "mdp_vsync";
        drive-strength = <2>;
        bias-disable;
    };
};
&{/chosen} { mars,native-display-test; };
/ {
 smp2p-adsp {
  compatible = "qcom,smp2p";
  qcom,smem = <443>, <429>;
  interrupts-extended = <&ipcc 3
          2
          1>;
  mboxes = <&ipcc 3
    2>;
  qcom,local-pid = <0>;
  qcom,remote-pid = <2>;
  smp2p_adsp_out: master-kernel {
   qcom,entry-name = "master-kernel";
   #qcom,smem-state-cells = <1>;
  };
  smp2p_adsp_in: slave-kernel {
   qcom,entry-name = "slave-kernel";
   interrupt-controller;
   #interrupt-cells = <2>;
  };
 };
    pmic-glink {
        compatible = "qcom,sm8350-pmic-glink", "qcom,pmic-glink";
        #address-cells = <1>;
        #size-cells = <0>;
        connector@0 {
            compatible = "usb-c-connector";
            reg = <0>;
            power-role = "dual";
            data-role = "dual";
        };
    };
    soc {
adsp: remoteproc@17300000 {
   compatible = "qcom,sm8350-adsp-pas";
   reg = <0 0x17300000 0 0x100>;
   interrupts-extended = <&pdc 6 1>,
           <&smp2p_adsp_in 0 1>,
           <&smp2p_adsp_in 1 1>,
           <&smp2p_adsp_in 2 1>,
           <&smp2p_adsp_in 3 1>;
   interrupt-names = "wdog", "fatal", "ready",
       "handover", "stop-ack";
   clocks = <&rpmhcc 0>;
   clock-names = "xo";
   power-domains = <&rpmhpd 4>,
     <&rpmhpd 5>;
   power-domain-names = "lcx", "lmx";
   memory-region = <&pil_adsp_mem>;
   qcom,qmp = <&aoss_qmp>;
   qcom,smem-states = <&smp2p_adsp_out 0>;
   qcom,smem-state-names = "stop";
   status = "okay";
   firmware-name = "qcom/sm8350/xiaomi/mars/adsp.mdt";
glink-edge {
interrupts-extended = <&ipcc 3 0 1>;
mboxes = <&ipcc 3 0>;
label = "lpass"; qcom,remote-pid = <2>;
}; };
    };
};
&{/soc/usb@a6f8800/usb@a600000} {
    dr_mode = "host";
    /delete-property/ usb-role-switch;
    /delete-property/ role-switch-default-mode;
    /delete-node/ port;
};
&{/chosen} { mars,fixed-host-test; };
&{/chosen} {
    /delete-property/ mars,fixed-host-test;
    mars,managed-usb-test;
};
&{/soc/usb@a6f8800/usb@a600000} {
    dr_mode = "otg";
    usb-role-switch;
    role-switch-default-mode = "peripheral";
    /delete-node/ port;
};
&{/pmic-glink/connector@0} { /delete-node/ port; };
