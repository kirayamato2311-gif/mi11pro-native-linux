+	switch (dsc->bits_per_component) {
+	case 8:
+	case 10:
+	case 12:
+		break;
+	default:
+		DRM_DEV_ERROR(&msm_host->pdev->dev,
+			"Unsupported DSC bits_per_component: %u\n", dsc->bits_per_component);
 		return -EOPNOTSUPP;
 	}
 
+	/* Experimental mars factory DSC PPS: the panel driver decodes and
+	 * roundtrip-validates every byte before attach. Keep the encoder's
+	 * parameters identical to the PPS delivered to this particular panel.
+	 * Other devices continue to use the generic RC calculation below.
+	 */
+	if (of_property_read_bool(msm_host->pdev->dev.of_node,
+				 "qcom,preserve-mars-factory-dsc-pps")) {
+		if (dsc->dsc_version_major != 1 || dsc->dsc_version_minor != 1 ||
+		    dsc->bits_per_component != 10 || dsc->bits_per_pixel != 128 ||
+		    dsc->pic_width != 1440 || dsc->pic_height != 3200 ||
+		    dsc->slice_width != 720 || dsc->slice_height != 50 ||
+		    dsc->slice_count != 2 || dsc->rc_model_size != 8192 ||
+		    !dsc->slice_chunk_size || !dsc->initial_dec_delay)
+			return -EINVAL;
+		DRM_DEV_INFO(&msm_host->pdev->dev,
+			"Using validated mars 10bpc factory DSC PPS\n");
+		return 0;
+	}
+
 	dsc->simple_422 = 0;
 	dsc->convert_rgb = 1;
 	dsc->vbr_enable = 0;
